# ───── Panel de la agencia ─────
# Usuario y contraseña para entrar (botón "Ingresar" → "Soy de la agencia").
ADMIN_USER=
ADMIN_PASSWORD=
# Email donde llegan las pruebas de los mails que se mandan desde el panel.
ADMIN_EMAIL=

# ───── Seguridad ─────
# Clave larga y al azar para firmar las sesiones. Generala con: openssl rand -hex 32
# No la cambies después: se cerrarían todas las sesiones y los links de baja viejos dejarían de andar.
SESSION_SECRET=

# ───── Dirección del sitio ─────
# Se usa en los links de los mails. Ej: https://automotoresaro.com.ar
SITE_URL=

# ───── Datos ─────
# Carpeta donde se guardan autos, fotos y clientes. En el VPS conviene fuera del proyecto.
DATA_DIR=

# ───── Envío de mails (SMTP) ─────
# Sirve cualquier proveedor (Brevo, Resend, Amazon SES, el correo del dominio...).
# Sin SMTP_HOST los mails no salen: se muestran en la consola (para probar).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente. Ej: Automotores Aro <ventas@automotoresaro.com.ar>
MAIL_FROM=

# ───── Solo si se publica en Vercel en vez del VPS ─────
BLOB_READ_WRITE_TOKEN=
