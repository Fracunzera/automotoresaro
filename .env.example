# Contraseña para entrar al panel (/admin). Obligatoria.
ADMIN_PASSWORD=

# Opcional: clave extra para firmar la sesión. Si la cambiás, se cierran todas las sesiones abiertas.
ADMIN_SECRET=

# Vercel Blob: se completa sola al crear el almacenamiento en Vercel (Storage > Blob).
# Sin esto, los datos se guardan en la carpeta data/ (sirve para probar en la compu).
BLOB_READ_WRITE_TOKEN=
